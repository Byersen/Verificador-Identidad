# --- Modelo y Paths ---
# Directorio donde se guardan model.joblib y scaler.joblib
MODEL_PATH=models/
# Archivos de datos generados por los scripts
EMBEDDINGS_DATA_PATH=data/embeddings.npy
LABELS_DATA_PATH=data/labels.csv

# --- Configuración de la API ---
API_PORT=5000
# Límite de subida de archivos en Megabytes
MAX_CONTENT_MB=5
# Umbral de confianza para decidir "soy yo"
VERIFY_THRESHOLD=0.75
# Versión del modelo para la respuesta JSON
MODEL_VERSION="me-verifier-v1"